# Copy to .env.local. One environment: the same values go into Vercel.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres. DATABASE_URL: transaction pooler (6543) for app queries.
# DIRECT_URL: session pooler or direct (5432) for drizzle-kit.
DATABASE_URL=
DIRECT_URL=

# AI (Vercel AI SDK). Switch provider by changing these five values.
# AI_PROVIDER: deepseek | anthropic | openai-compatible
# AI_BASE_URL: optional for deepseek/anthropic, required for openai-compatible.
# AI_MODEL_FAST: card grading, quizzes. AI_MODEL_SMART: mock interviewer.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_FAST=deepseek-flash
AI_MODEL_SMART=deepseek-v4-pro

# App URL (QStash calls back here; use your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase secret key: Project Settings > API Keys > Secret keys.
# Server only: nightly jobs write missions and reviews for every user.
SUPABASE_SECRET_KEY=

# Upstash Redis: console.upstash.com > Redis > your database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (also used by Upstash Workflow): console.upstash.com > QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Vector: console.upstash.com > Vector > create index with a built-in
# embedding model (e.g. BAAI/bge-base-en-v1.5), then copy from its REST API tab
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Web push (VAPID). Generated locally; keep the private key secret.
# VAPID_SUBJECT must be a mailto: address you own.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Sentry: sentry.io > create a Next.js project. DSN from Client Keys;
# auth token from Settings > Auth Tokens (for source maps on deploy).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# App settings
AI_MONTHLY_BUDGET_USD=10
LEETCODE_SYNC_ENABLED=true
