{
  "name": "90x-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && oxlint --deny-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:new": "supabase migration new --workdir ..",
    "db:push": "dotenv -e .env.local -- sh -c 'supabase db push --workdir .. --db-url \"$DIRECT_URL\"'",
    "db:pull": "dotenv -e .env.local -- drizzle-kit pull && bun run scripts/fix-pulled-schema.ts",
    "db:types": "dotenv -e .env.local -- sh -c 'supabase gen types typescript --db-url \"$DIRECT_URL\" --schema public > src/lib/supabase/database.types.ts'",
    "check:analytics": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-analytics.ts",
    "check:jobs": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-jobs.ts",
    "check:tracker": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-tracker.ts",
    "check:rls": "dotenv -e .env.local -- bun run scripts/check-rls.ts",
    "check:db-guards": "dotenv -e .env.local -- bun run scripts/check-db-guards.ts",
    "check:user-scope": "bun run scripts/check-user-scope.ts",
    "fix:card-missions": "dotenv -e .env.local -- bun run scripts/fix-card-missions.ts",
    "backfill:xp": "dotenv -e .env.local -- bun run scripts/backfill-xp.ts",
    "admin:grant": "dotenv -e .env.local -- bun run scripts/admin-grant.ts",
    "schedule:jobs": "dotenv -e .env.local -- bun run scripts/schedule-jobs.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:tokens": "bun run scripts/check-tokens.ts",
    "check:dead": "knip",
    "check:deps": "bun run scripts/check-deps.ts",
    "check:audit": "bun run scripts/check-audit.ts",
    "check:actions": "bun run scripts/check-actions.ts",
    "check:grading": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-grading.ts",
    "check:feed": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-feed.ts",
    "check:friends": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-friends.ts",
    "check:share": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-share.ts",
    "check:push": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-push.ts",
    "check:coach": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-coach.ts",
    "check:coach-tools": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-coach-tools.ts",
    "check:dupes": "jscpd",
    "check:bundle": "bun run scripts/check-bundle.ts",
    "check:cycles": "dpdm --no-warning --no-tree --exit-code circular:1 --transform \"src/**/*.ts\" \"src/**/*.tsx\"",
    "test:coverage": "vitest run --coverage",
    "check:coverage": "vitest run --coverage && bun run scripts/check-coverage.ts",
    "check:shards": "bun run scripts/check-shards.ts",
    "check:archetypes": "bun run scripts/check-archetypes.ts",
    "generate:archetypes": "bun run scripts/generate-archetypes.ts",
    "break-in": "dotenv -e .env.local -- bun --conditions=react-server scripts/break-in/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/react": "^4.0.119",
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@base-ui/react": "^1.8.0",
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ai": "^7.0.116",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lenis": "1.1.22",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "6.30.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "ts-fsrs": "5.4.2",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "dpdm": "4.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-security": "4.1.0",
    "jscpd": "5.3.3",
    "knip": "^6.38.0",
    "opentype.js": "2.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "sharp": "0.35.5",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "postgres@3.4.9": "patches/postgres@3.4.9.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
