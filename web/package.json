{
  "name": "90x-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:new": "supabase migration new --workdir ..",
    "db:push": "dotenv -e .env.local -- sh -c 'supabase db push --workdir .. --db-url \"$DIRECT_URL\"'",
    "db:pull": "dotenv -e .env.local -- drizzle-kit pull && bun run scripts/fix-pulled-schema.ts",
    "db:types": "dotenv -e .env.local -- sh -c 'supabase gen types typescript --db-url \"$DIRECT_URL\" --schema public > src/lib/supabase/database.types.ts'",
    "check:tracker": "dotenv -e .env.local -- bun --conditions=react-server scripts/check-tracker.ts",
    "check:rls": "dotenv -e .env.local -- bun run scripts/check-rls.ts",
    "admin:grant": "dotenv -e .env.local -- bun run scripts/admin-grant.ts",
    "schedule:jobs": "dotenv -e .env.local -- bun run scripts/schedule-jobs.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.116",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
